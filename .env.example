# Serie A Prediction System - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# ODDS API (The Odds API - for live betting odds)
# Get your key at: https://the-odds-api.com/
# =============================================================================
ODDS_API_KEY=your_odds_api_key_here

# =============================================================================
# OPENAI API (for AI-powered reasoning)
# Get your key at: https://platform.openai.com/api-keys
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# PERPLEXITY API (DEPRECATED — replaced by Gemini + Groq below)
# =============================================================================
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# =============================================================================
# GOOGLE GEMINI (primary — sentiment analysis with Google Search grounding)
# Get your key at: https://aistudio.google.com/apikey
# Free: 5,000 grounded queries/month
# =============================================================================
GOOGLE_GEMINI_KEY=your_gemini_key_here

# =============================================================================
# GROQ (fallback — compound-beta with built-in web search)
# Get your key at: https://console.groq.com/keys
# Free: no credit card, rate-limited
# =============================================================================
GROQ_API_KEY=your_groq_key_here

# =============================================================================
# API-FOOTBALL (for confirmed lineups before kickoff)
# Get your key at: https://rapidapi.com/api-sports/api/api-football
# Free tier: 100 requests/day (sufficient for Serie A)
# =============================================================================
APIFOOTBALL_KEY=your_api_football_key_here

# =============================================================================
# FOOTBALL-DATA.ORG (fallback for squad rosters)
# Get your key at: https://www.football-data.org/client/register
# Free tier: 10 requests/minute (sufficient for squad fetching)
# =============================================================================
FOOTBALLDATA_KEY=your_footballdata_key_here

# =============================================================================
# TELEGRAM NOTIFICATIONS (optional — alerts for pipeline events)
# Create a bot via @BotFather, get chat ID via @userinfobot
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# ANTHROPIC API (for AI Advisor chat in web dashboard)
# Get your key at: https://console.anthropic.com/
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# EMAIL ALERTS (optional — fallback notifications via SMTP)
# =============================================================================
# ALERT_EMAIL=your_email@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_here

# =============================================================================
# FLASK/WEB APP
# =============================================================================
PORT=5001
